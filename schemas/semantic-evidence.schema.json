{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hex digest identifying the exact before/after snapshot"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "server": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "configuration": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "name",
                  "version",
                  "configuration"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unhealthy",
              "not-installed",
              "disabled",
              "needs-opt-in",
              "not-ready",
              "failed"
            ]
          },
          "capabilitiesAttempted": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "definition",
                "references",
                "callHierarchy",
                "implementation",
                "typeDefinition",
                "diagnostics"
              ]
            }
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "capability": {
                  "type": "string",
                  "enum": [
                    "definition",
                    "references",
                    "callHierarchy",
                    "implementation",
                    "typeDefinition",
                    "diagnostics"
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "capability",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "guidance": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "language",
          "server",
          "status",
          "capabilitiesAttempted",
          "failures",
          "guidance"
        ],
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ev_[0-9a-f]{16}$",
            "description": "Generated ID: \"ev_\" + 16 hex characters"
          },
          "relation": {
            "type": "string",
            "enum": [
              "calls",
              "references",
              "implements"
            ]
          },
          "sourceEntityId": {
            "type": "string",
            "pattern": "^ent_[0-9a-f]{16}$",
            "description": "Generated ID: \"ent_\" + 16 hex characters"
          },
          "targetEntityId": {
            "type": "string",
            "pattern": "^ent_[0-9a-f]{16}$",
            "description": "Generated ID: \"ent_\" + 16 hex characters"
          },
          "location": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Repository-relative, \"/\"-separated path as Git reports it"
              },
              "side": {
                "type": "string",
                "enum": [
                  "old",
                  "new"
                ]
              },
              "range": {
                "type": "object",
                "properties": {
                  "startLine": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "startColumn": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "endColumn": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "startLine",
                  "endLine"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "path",
              "side",
              "range"
            ],
            "additionalProperties": false
          },
          "method": {
            "type": "string",
            "enum": [
              "text-search",
              "import-resolution",
              "lsp"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "candidate",
              "confirmed",
              "rejected"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "relation",
          "sourceEntityId",
          "targetEntityId",
          "location",
          "method",
          "outcome",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "caps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "pattern": "^ent_[0-9a-f]{16}$",
            "description": "Generated ID: \"ent_\" + 16 hex characters"
          },
          "relation": {
            "type": "string",
            "enum": [
              "calls",
              "references",
              "implements"
            ]
          },
          "shown": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "entityId",
          "relation",
          "shown",
          "total"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "snapshotId",
    "languages",
    "records",
    "caps"
  ],
  "additionalProperties": false,
  "title": "semantic-evidence v1",
  "$comment": "Generated from src/schemas by `npm run schemas`; do not edit. Refinements that JSON Schema cannot express (repository-relative paths, range order) are checked by the Zod schemas only."
}
