{
  // Type-checks everything (sources, tests, scripts, fixtures). Emitting is done by tsconfig.build.json.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Lets scripts run directly with Node's type stripping, and lets src import `./x.ts`.
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "test/fixtures", "test/ai", "test/skill", "vite.config.ts"],
  // The viewer runs in a browser and has its own tsconfig (src/viewer/tsconfig.json).
  "exclude": ["src/viewer"]
}
